#!/bin/bash
# Run the Google Workspace CLI (`gws`) as a specific exported account.
#
# Background: `gws` keeps only one active credential set at a time, and its
# older `gws mcp` server was removed upstream. This wrapper mints a fresh
# access token from a per-account credential file and passes it via
# GOOGLE_WORKSPACE_CLI_TOKEN (highest priority in the gws auth chain), so
# each account stays isolated.
#
# Usage:
#   gws-acct <account> <gws args...>
#   gws-acct personal gmail users messages list --params '{"userId":"me"}'
#   gws-acct work drive files list --params '{"pageSize":10}'
#
# Credential files live at ${GWS_CONFIG_DIR:-~/.config/gws}/<account>.json and
# are produced by: gws auth export --unmasked > ~/.config/gws/<account>.json

set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "usage: gws-acct <account> <gws args...>" >&2
  exit 2
fi

ACCT="$1"
shift

CREDS="${GWS_CONFIG_DIR:-$HOME/.config/gws}/${ACCT}.json"
if [ ! -f "$CREDS" ]; then
  echo "gws-acct: no credential file: $CREDS" >&2
  exit 1
fi

TOKEN=$(CREDS="$CREDS" python3 -c '
import json, os, sys, urllib.request, urllib.parse

with open(os.environ["CREDS"]) as f:
    d = json.load(f)

data = urllib.parse.urlencode({
    "client_id": d["client_id"],
    "client_secret": d["client_secret"],
    "refresh_token": d["refresh_token"],
    "grant_type": "refresh_token",
}).encode()

try:
    req = urllib.request.Request("https://oauth2.googleapis.com/token", data)
    resp = json.loads(urllib.request.urlopen(req).read())
    print(resp["access_token"])
except Exception as e:
    print(f"token mint failed: {e}", file=sys.stderr)
    sys.exit(1)
')

if [ -z "$TOKEN" ]; then
  echo "gws-acct: failed to mint access token for '$ACCT'" >&2
  exit 1
fi

exec env GOOGLE_WORKSPACE_CLI_TOKEN="$TOKEN" gws "$@"
